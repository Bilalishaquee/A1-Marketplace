{
  "name": "a1-renovations-ai-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A-1 Renovations — Phase 2 AI Engine & Estimation Logic backend",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:live": "node --env-file-if-exists=.env --experimental-strip-types scripts/liveCheck.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate dev --skip-generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:admin": "node --env-file-if-exists=.env --experimental-strip-types scripts/seedAdmin.ts",
    "seed:training": "node --env-file-if-exists=.env --experimental-strip-types scripts/seedTrainingExamples.ts",
    "eval": "node --env-file-if-exists=.env --experimental-strip-types scripts/evalScope.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "openai": "^4.104.0",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.20",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3"
  }
}
