# A-1 Renovations API
# Copy to .env and fill in private values.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# AI providers
MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_SCOPE_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Fine-tuning
FINETUNE_MIN_EXAMPLES=10
FINETUNE_BASE_MODEL=gpt-4o-mini-2024-07-18

# Image rendering
RENDER_PROVIDER=mock
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Supabase database
STORE=prisma
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Auth
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-a-strong-random-secret"
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Supabase storage
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="a1-project-files"
SUPABASE_SIGNED_READ_TTL_SEC=3600

# Estimation
DEFAULT_REGION=90001
MAX_IMAGES_PER_QUOTE=8
QUOTE_VALIDITY_DAYS=14
